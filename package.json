{
  "name": "nextjs-app-router-all-in-one",
  "version": "0.1.0",
  "private": true,
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "postinstall": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretty": "yarn prettier 'src/**/*.{ts,js,tsx,jsx}' --write",
    "checkifrunning": "node -e \"try { require('child_process').execSync(process.platform === 'win32' ? 'netstat -ano | findstr :3000' : 'lsof -i :3000', {stdio: 'ignore'}); process.exit(0); } catch (e) { process.exit(1); }\"",
    "test": "yarn checkifrunning && jest || start-server-and-test dev http://localhost:3000 jest",
    "jest:unit": "jest --testPathPatterns='src/app/api/.*\\.test\\.tsx?$|src/components/.*\\.test\\.tsx?$'",
    "jest:integration": "jest --testPathPatterns='src/app/(?!api).*\\.test\\.tsx?$'",
    "test:unit": "yarn checkifrunning && yarn jest:unit || start-server-and-test dev http://localhost:3000 \"yarn jest:unit\"",
    "test:integration": "yarn checkifrunning && yarn jest:integration || start-server-and-test dev http://localhost:3000 \"yarn jest:integration\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "g": "plop --plopfile ./generator/plopfile.mjs",
    "e2e": "start-server-and-test dev http://localhost:3000 \"cypress open --e2e\"",
    "e2e:headless": "start-server-and-test dev http://localhost:3000 \"cypress run --e2e\""
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "apollo-upload-client": "^19.0.0",
    "cookies-next": "^6.1.1",
    "graphql": "^16.14.0",
    "next": "^16.3.1",
    "react": "^19",
    "react-dom": "^19",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-links": "^10.5.9",
    "@storybook/nextjs": "^10.5.9",
    "@storybook/react": "^10.5.9",
    "@swc/plugin-styled-components": "^12.9.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/apollo-upload-client": "^19.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^15.21.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.5.9",
    "husky": "^9.1.7",
    "isomorphic-fetch": "^3.0.0",
    "jest": "^30",
    "jest-environment-jsdom": "^30",
    "jest-styled-components": "^7.4.0",
    "ora": "^9.4.1",
    "plop": "^4.0.5",
    "prettier": "^3.9.6",
    "start-server-and-test": "^2.1.5",
    "storybook": "^10.5.9",
    "ts-jest": "^29.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  }
}
